# ========================================================
# Coding Wallah Skills - Production Environment Variables
# ========================================================

# Application Environment
NODE_ENV=production
PORT=8080

# Production Custom Domain (e.g., codingwallahskills.com)
CUSTOM_DOMAIN=codingwallahskills.com
SITE_URL=https://codingwallahskills.com

# Optional Backend AI / OpenAI Integration
OPENAI_API_KEY=
GEMINI_API_KEY=

# Hosting Platform Specific Settings
# Netlify / Vercel automatically inject SITE_URL and NODE_ENV
